rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Global security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for UserProfile entity
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'name']) &&
             data.keys().hasOnly([
               'uid', 'name', 'email', 'avatar', 'plan',
               'notificationsEnabled', 'riskAlertsEnabled',
               'soundEnabled', 'autoRefresh',
               'preferredPairs', 'createdAt', 'updatedAt'
             ]) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 120 &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500)) &&
             (!('plan' in data) || (data.plan is string && data.plan.size() <= 50)) &&
             (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
             (!('riskAlertsEnabled' in data) || data.riskAlertsEnabled is bool) &&
             (!('soundEnabled' in data) || data.soundEnabled is bool) &&
             (!('autoRefresh' in data) || data.autoRefresh is bool) &&
             (!('preferredPairs' in data) || (data.preferredPairs is list && data.preferredPairs.size() <= 20));
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      // Direct access allowed only to the authenticated owner
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      
      // Document creation strictly binds to the caller's auth UID
      allow create: if isOwner(userId) &&
                       incoming().uid == request.auth.uid &&
                       isValidUserProfile(incoming());

      // Update strictly requires valid schema and immutable UID
      allow update: if isOwner(userId) &&
                       incoming().uid == existing().uid &&
                       isValidUserProfile(incoming());

      // Only the user themselves can delete their profile
      allow delete: if isOwner(userId);
    }
  }
}
